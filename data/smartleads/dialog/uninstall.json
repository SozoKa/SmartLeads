{
  "type": "minecraft:confirmation",
  "title": {
    "text": "SmartLeads - ",
    "extra": [
      {
        "translate": "sozoka.uninstall",
        "fallback": "Uninstall"
      }
    ]
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "sozoka.are_you_sure",
        "fallback": "Are you sure?"
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "sozoka.uninstall_explanations",
        "fallback": "Clicking 'Yes' will remove all scoreboards, storages, teams that make this datapack work on your world/server. To ensure the datapack is properly uninstalled, disable/remove/uninstall it immediately after confirming."
      },
      "width": 300
    }
  ],
  "inputs": [],
  "can_close_with_escape": true,
  "yes": {
    "label": {
      "translate": "gui.yes"
    },
    "action": {
      "type": "minecraft:run_command",
      "command": "function smartleads:-uninstall"
    }
  },
  "no": {
    "label": {
      "translate": "gui.cancel"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "smartleads:about"
    }
  }
}